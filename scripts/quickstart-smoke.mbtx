----
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
}
----

// SPDX-License-Identifier: Apache-2.0
fn field(document : Json, group : String, key : String) -> Json raise {
  guard document is Object(root) else { fail("expected JSON document") }
  guard root.get(group) is Some(Object(fields)) else { fail("missing " + group) }
  fields.get(key).unwrap()
}

fn unit_cube(document : Json) -> Unit raise {
  for (group, key, expected) in [
    ("geometry", "triangles", 12.0),
    ("geometry", "surface_area_mm2", 6.0),
    ("geometry", "volume_mm3", 1.0),
    ("validation", "boundary_edges", 0.0),
    ("validation", "non_manifold_edges", 0.0),
  ] {
    guard field(document, group, key) is Number(value, ..) else { fail("missing numeric " + key) }
    assert_true((value - expected).abs() < 1.0e-9, msg=key)
  }
  assert_eq(field(document, "review", "needs_review"), Json(false))
}

async fn cli(args : Array[String]) -> String {
  let result = @shell.Cmd("moon", ["run", "cmd/main"] + args).output(timeout_ms=60000)
  guard result.exit_code() == 0 else { fail(result.stdout() + result.stderr()) }
  result.stdout()
}

async fn main {
  let plain = cli(["examples/cube.obj", "--strict"])
  assert_true(plain.contains("三角形") && plain.contains("表面积"))
  let json_args = ["--json", "--samples", "32", "--min-thickness", "0", "--strict"]
  unit_cube(@json.parse(cli(["examples/cube.obj"] + json_args)))
  let dir = "_build/quickstart-smoke"
  if !@fs.path_exists(dir) { @fs.create_dir(dir) }
  let fixed = dir + "/fixed.stl"
  let repair = cli(["examples/broken.stl", "--fix", fixed, "--strict"])
  assert_true(repair.contains("已重读导出文件"))
  assert_true(@fs.read_file_to_bytes(fixed).length() > 84)
  unit_cube(@json.parse(cli([fixed] + json_args)))
  println("QUICKSTART_OK: cube 12 faces / volume 1 / area 6; strict exit 0; one-hole repair and actual-file reload; JSON v1")
}
