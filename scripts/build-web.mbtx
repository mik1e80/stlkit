----
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
}
----

// SPDX-License-Identifier: Apache-2.0
// Cross-platform equivalent of web/build.sh, including redistributed licenses.
async fn main {
  guard @fs.path_exists("moon.mod") && @fs.path_exists("web/moon.pkg") else {
    fail("Run this script from the STLKit repository root")
  }
  @shell.Cmd("moon", ["build", "--target", "js", "--release"]).run(timeout_ms=120000)
  for dir in ["web/dist", "web/licenses"] {
    if !@fs.path_exists(dir) { @fs.create_dir(dir) }
  }
  let user_dir = @env.get_env_var("USERPROFILE").unwrap_or(@env.get_env_var("HOME").unwrap_or(""))
  let moon_dir = @env.get_env_var("MOON_HOME").unwrap_or(user_dir + "/.moon")
  for (source, destination) in [
    ("_build/js/release/build/web/web.js", "web/dist/web.js"),
    ("LICENSE", "web/licenses/project.LICENSE"),
    ("THIRD_PARTY_NOTICES.md", "web/licenses/THIRD_PARTY_NOTICES.md"),
    (".mooncakes/hustcer/fzip/LICENSE", "web/licenses/fzip.LICENSE"),
    (".mooncakes/Milky2018/xml/LICENSE", "web/licenses/xml.LICENSE"),
    (moon_dir + "/lib/core/LICENSE", "web/licenses/moonbit-core.LICENSE"),
    (moon_dir + "/lib/core/NOTICE", "web/licenses/moonbit-core.NOTICE"),
  ] {
    @fs.write_bytes_to_file(destination, @fs.read_file_to_bytes(source))
  }
  println("WEB_BUILD_OK: regenerated browser code and preserved complete dependency licenses")
}
