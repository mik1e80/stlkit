name = "mik1e80/stlkit"

version = "0.1.1"

readme = "README.mbt.md"

repository = "https://github.com/mik1e80/stlkit"

license = "Apache-2.0"

keywords = [
  "stl",
  "obj",
  "3mf",
  "ply",
  "3d",
  "mesh",
  "3d-printing",
  "watertight",
]

description = "MoonBit 实现的 STL/OBJ/3MF/PLY 网格工具链：解析、打印前复核、修复、分析与流式扫描"

import {
  "moonbitlang/x@0.5.5",
  "moonbitlang/async@0.22.1",
  "hustcer/fzip@0.8.7",
  "Milky2018/xml@0.5.0",
}
